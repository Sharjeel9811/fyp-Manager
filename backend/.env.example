MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fyp_manager"
JWT_SECRET="change-me"
JWT_EXPIRE="7d"
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
# Optional LLM keys for the mock-defense examiner (backend-side only; students'
# browsers never call these APIs). Without any key the mock defense falls back
# to the deterministic rule-based examiner.
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
